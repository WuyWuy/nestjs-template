model Cart {
    id           Int @id @default(autoincrement())
    userId     Int        @unique
    user       User       @relation(fields: [userId], references: [id])
    cartItems  CartItem[]
}

model CartItem {
    id        Int       @id @default(autoincrement())
    cartId    Int
    foodId    Int
    quantity  Int
    deletedAt DateTime?

    cart Cart @relation(fields: [cartId], references: [id])
    food Food @relation(fields: [foodId], references: [id])

    @@index([cartId])
    @@index([foodId])
}
